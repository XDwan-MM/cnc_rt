{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch Qt App",
            "type": "cppdbg",
            "request": "launch",
            // 【重点1】指向 build 目录下生成的可执行文件
            // 如果你的 pro 文件里指定了 TARGET = myapp，这里就是 myapp
            // 如果没指定，默认通常是项目文件夹的名字
            "program": "${workspaceFolder}/bin/rt_cnc_d", 
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build", // 工作目录设为 build
            "environment": [],
            "externalConsole": false, // WSLg 不需要 externalConsole
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/sudo_gdb.sh",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // 【重点2】调试前先运行上面的编译任务
            "preLaunchTask": "QMake Build"
        }
    ]
}